        {
          "name": "Apply For Career - Production Popup Compatibility",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.applicationId) {",
                  "  pm.environment.set('careerApplicationId', json.data.applicationId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "fullName",
                  "value": "Production Popup Applicant",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "{{careerApplicationEmail}}",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "9999999999",
                  "type": "text"
                },
                {
                  "key": "currentLocation",
                  "value": "Bhubaneswar",
                  "type": "text"
                },
                {
                  "key": "experience",
                  "value": "2 years",
                  "type": "text"
                },
                {
                  "key": "position",
                  "value": "Enterprise Operations Coordinator",
                  "type": "text"
                },
                {
                  "key": "careerId",
                  "value": "{{careerId}}",
                  "type": "text"
                },
                {
                  "key": "coverLetter",
                  "value": "Application submitted from the production-compatible endpoint.",
                  "type": "text"
                },
                {
                  "key": "division",
                  "value": "{{websiteKey}}",
                  "type": "text"
                },
                {
                  "key": "sourcePage",
                  "value": "/careers",
                  "type": "text"
                },
                {
                  "key": "resume",
                  "type": "file",
                  "src": "{{resumeFilePath}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/public/{{websiteKey}}/career-applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "{{websiteKey}}",
                "career-applications"
              ]
            },
            "description": "Backward-compatible public endpoint used by the deployed careers popup. careerId should be the active Career MongoDB _id. If omitted, position must exactly match the active job title."
          },
          "response": []
        }
      ]
    },
    {
